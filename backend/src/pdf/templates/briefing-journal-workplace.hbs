<!DOCTYPE html>
<html lang="ru">
<head>
  <meta charset="UTF-8">
  <style>
    @page { size: A4 landscape; margin: 15mm; }
    body { font-family: 'Times New Roman', serif; font-size: 8pt; }
    h2 { text-align: center; font-size: 11pt; margin-bottom: 4px; }
    .subtitle { text-align: center; font-size: 9pt; margin-bottom: 8px; }
    .org-info { margin-bottom: 12px; }
    table { width: 100%; border-collapse: collapse; }
    th, td { border: 1px solid #000; padding: 3px; text-align: center; vertical-align: middle; }
    th { background: #f0f0f0; font-size: 7.5pt; }
    .sign-col { width: 55px; min-height: 25px; }
  </style>
</head>
<body>
  <div class="org-info">
    <strong>Организация:</strong> {{orgName}} &nbsp;&nbsp;&nbsp;
    <strong>Подразделение:</strong> {{deptName}}
  </div>

  <h2>ЖУРНАЛ РЕГИСТРАЦИИ ИНСТРУКТАЖА НА РАБОЧЕМ МЕСТЕ</h2>
  <div class="subtitle">
    Период: с {{periodStart}} по {{periodEnd}}
  </div>

  <table>
    <thead>
      <tr>
        <th rowspan="2">№</th>
        <th rowspan="2">Дата</th>
        <th rowspan="2">ФИО инструктируемого</th>
        <th rowspan="2">Год рождения</th>
        <th rowspan="2">Профессия / должность</th>
        <th rowspan="2">Вид инструктажа</th>
        <th rowspan="2">Причина внепл. / целевого</th>
        <th colspan="2">Стажировка</th>
        <th colspan="2">Допуск к самост. работе</th>
        <th class="sign-col" rowspan="2">Подпись инструктируемого</th>
        <th class="sign-col" rowspan="2">Подпись инструктора</th>
      </tr>
      <tr>
        <th>кол-во смен</th>
        <th>с ___ по ___</th>
        <th>дата</th>
        <th>подпись допускающего</th>
      </tr>
    </thead>
    <tbody>
      {{#each records}}
      <tr>
        <td>{{rowIndex}}</td>
        <td>{{conductedAt}}</td>
        <td>{{employeeName}}</td>
        <td>{{birthYear}}</td>
        <td>{{position}}</td>
        <td>{{briefingType}}</td>
        <td>{{unplannedReason}}</td>
        <td>{{internshipShifts}}</td>
        <td>{{internshipPeriod}}</td>
        <td>&nbsp;</td>
        <td>&nbsp;</td>
        <td>&nbsp;</td>
        <td>&nbsp;</td>
      </tr>
      {{/each}}
    </tbody>
  </table>
</body>
</html>
